menu "E3-StepMotor module"

config E3_SPEED_SPS
    int "Velocidad del motor en pasos por segundo"
    range 50 2000
    default 500
    help
      500 pasos/s equivalen a 2 cm/s con el riel de 0,8 cm por revolucion.

config E3_CALIB_SPEED_SPS
    int "Velocidad de busqueda de switches en pasos por segundo"
    range 50 1000
    default 300
    help
      Mas lenta que la de marcha porque la busqueda avanza a proposito
      contra un switch.

endmenu
