+
+    // Kundt tube
+
+    /*
+     * The route parameter is named `id`, matching tank and NOT electron
+     * diffraction. ValidReservationGuard reads `request.params.id`, so a route
+     * declaring `:platform_id` leaves it undefined, the guard looks up a
+     * reservation for NaN and every POST comes back 403. Electron diffraction
+     * has that bug today; this avoids inheriting it.
+     */
+    @Get('kundt-get/:id')
+    getKundt(@Param('id', ParseIntPipe) platform_id: number)
+    {
+        return this.expService.getKundtExp(platform_id);
+    }
+
+    @UseGuards(ValidReservationGuard)
+    @Post('kundt-set/:id')
+    updateKundt(@Param('id', ParseIntPipe) platform_id: number, @Body() actuators: KundtActuators){
+        return this.expService.setKundtExp(platform_id, actuators);
+    }
+
+    @Sse('kundt-updates')
+    kundtAlerts(): Observable<MessageEvent>{
+        return fromEvent(this.eventEmitter, 'kundt-update').pipe(map(sensors => ({data:sensors as object})));
+    }
+
 }
