 import { Injectable, NotFoundException, InternalServerErrorException } from "@nestjs/common";
 import { ElectronDiffractionActuators, ElectronDiffractionCamera, ElectronDiffractionRow } from "src/dto/electron_diffraction.dto";
+import { KundtActuators, KundtRow } from "src/dto/kundt.dto";
 import { PendulumActuators, PendulumRow } from "src/dto/pendulum.dto";
 import { TankRow, TankActuators, TankCamera } from "src/dto/tank.dto";
-import { ELECTRON_DIFFRACTION_TOPIC, PENDULUM_TOPIC, TANK_TOPIC } from "src/mqtt/channels";
+import { ELECTRON_DIFFRACTION_TOPIC, KUNDT_TOPIC, PENDULUM_TOPIC, TANK_TOPIC } from "src/mqtt/channels";
 import { MqttService } from "src/mqtt/mqtt.service";
 import { PrismaService } from "src/prisma/prisma.service";
 
@@ -378,4 +379,72 @@ export class ExpService {
         return { camera_position: entry.stepper_pos };
 
     }
+
+
+    // Kundt tube
+
+    kundtEntry2Actuators(entry: KundtRow) {
+        let actuators: Object = {
+            frequency: entry.frequency,
+            volume: entry.volume,
+            plunger_pos: entry.plunger_pos,
+        }
+        return actuators;
+    }
+
+
+    async getKundtExp(id: number) {
+        // The three modules share a single ExpBase, so index 0 is the only one
+        const row = await this.getExpBaseByIndex(id, 0);
+
+        const exp_entry = await this.prisma.kundt.findUnique({
+            where: {
+                id: row.id
+            }
+        });
+
+        if (exp_entry === null) {
+            throw new NotFoundException(
+                `No se encontró el experimento con ID ${row.id}`
+            );
+        }
+
+        return exp_entry;
+    }
+
+
+    async setKundtExp(platform_id: number, actuators: KundtActuators) {
+
+        const entry = await this.getKundtExp(platform_id);
+
+        const updated_entry = await this.prisma.kundt.update({
+            where: {
+                id: entry.id,
+            },
+            data:
+            {
+                frequency: actuators.frequency,
+                volume: actuators.volume,
+                plunger_pos: actuators.plunger_pos,
+            }
+        });
+
+        const as_object = this.kundtEntry2Actuators(updated_entry);
+
+        /*
+         * `calibrate` rides along with the setpoints but is never stored: see
+         * the note on the DTO. Only add it when explicitly requested, so a
+         * routine frequency change does not send the plunger home.
+         */
+        const computed_body = {
+            id: entry.id,
+            actuators: actuators.calibrate === true
+                ? { ...as_object, calibrate: true }
+                : as_object
+        };
+
+        await this.mqttService.publishUpdate(KUNDT_TOPIC, platform_id, entry.id, computed_body);
+
+        return computed_body;
+    }
 }
