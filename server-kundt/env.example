# Plantilla para curiousBeagleAPI/.env y .env-dev (npm run start:dev lee .env-dev,
# no .env). Rellenar con valores locales; ninguno de estos archivos se versiona.
#
# Para el camino de Kundt sólo hacen falta las tres primeras.
DATABASE_URL="postgresql://sirius:CAMBIAR@localhost:5432/curious-beagle-db"
MQTT_URL=mqtt://localhost:1883
JWT_SECRET=CAMBIAR

PORT=3000
CORS_ORIGINS=http://localhost:5173

# La API lee VALKEY_PASS; el docker-compose usa VALKEY_PASSWORD. Son distintas
# y el valor tiene que coincidir entre ambas.
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASS=CAMBIAR

CAMERA_API=http://localhost:1984

# Correo: no interviene en el camino de Kundt. Sólo OTP y recuperación.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173
RECOVER_URL_SUFFIX=/recover

# Para curiousBeagle/.env (docker-compose):
#   POSTGRES_USER TIENE que ser "sirius": el volcado schema.sql lleva 15
#   sentencias OWNER TO sirius y no crea el rol. Con otro nombre la
#   inicialización de la base aborta entera.
# POSTGRES_DB=curious-beagle-db
# POSTGRES_USER=sirius
# POSTGRES_PASS=CAMBIAR
# VALKEY_PASSWORD=CAMBIAR
